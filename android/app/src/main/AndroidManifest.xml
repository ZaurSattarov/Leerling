<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Push notificaties (Fase 5) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Camera: uitsluitend voor de QR-scanner op /koppelcode/scan.
         Wordt runtime-aangevraagd door mobile_scanner op het moment
         dat de scanner-scherm wordt geopend, nooit eerder. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false"/>

    <application
        android:label="Klantio L"
        android:name="com.klantio.leerling.KlantioLeerlingApplication"
        tools:replace="android:name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="leerlingplanner" android:host="auth"/>
            </intent-filter>
            <!-- Mollie-factuurbetaling: return-pagina (mollie-factuur-return)
                 opent "Open in Klantio" via leerlingplanner://factuur?id=... -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="leerlingplanner" android:host="factuur"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

  <!-- Live Aankomst (Feature 2, Fase 3): Google Maps SDK for Android.
     Waarde komt uit android/local.properties (MAPS_API_KEY) via de
     manifestPlaceholder in build.gradle.kts, nooit hier hardcoded. -->
<meta-data
    android:name="com.google.android.geo.API_KEY"
    android:value="${mapsApiKey}" />

        <!-- Android notificatiekanalen (2026-09-01): bestaande backend/FCM-payloads
             verwijzen expliciet naar channel_id's zoals klantio_lessen. Zonder een
             geldige default valt Android 8+ terug op een fallback-kanaal en toont het
             de tray-notification niet correct. Kanalen zelf worden aangemaakt door
             NotificationChannels.ensureCreated (zie KlantioLeerlingApplication,
             MainActivity, NotificationChannelInitProvider). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="klantio_algemeen" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:value="@drawable/ic_stat_notify" />

        <provider
            android:name="com.klantio.leerling.NotificationChannelInitProvider"
            android:authorities="com.klantio.leerling.notificationchannelinit"
            android:exported="false"
            android:initOrder="100" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- https/http: Mollie checkout, PDF factuur -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="http"/>
        </intent>
        <!-- tel: Bellen naar instructeur -->
        <intent>
            <action android:name="android.intent.action.DIAL"/>
            <data android:scheme="tel"/>
        </intent>
        <!-- whatsapp: WhatsApp knop -->
        <package android:name="com.whatsapp"/>
        <!-- Google Maps: Route knop -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="geo"/>
        </intent>
    </queries>
</manifest>
